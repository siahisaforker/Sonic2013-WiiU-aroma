# Use dkosmari's pre-built image — all devkitPro/wiiu-dev packages are
# already installed, so no dkp-pacman calls are needed (avoids IP bans
# from the devkitPro package server on CI runners).
# Source: https://github.com/dkosmari/devkitpro-docker-images
FROM dkosmari/devkitppc-wiiu-debian:latest

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    imagemagick \
    python3 \
  && rm -rf /var/lib/apt/lists/*

# SDL is built from the vendored local source (dependencies/all/SDL) by the
# Makefile, so wiiu-sdl2-libs is not needed here.

WORKDIR /workspace
CMD ["python3", "scripts/build.py", "all"]

