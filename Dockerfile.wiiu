FROM devkitpro/devkitppc:latest

RUN apt-get update && apt-get install -y --no-install-recommends python3 && \
    rm -rf /var/lib/apt/lists/*

RUN dkp-pacman -Syyu --noconfirm && \
    dkp-pacman -S --noconfirm --needed wiiu-dev ppc-libvorbisidec ppc-libvorbis ppc-libogg

# SDL is built from the vendored local source (dependencies/all/SDL) by the
# Makefile, so no separate SDL install is needed here.

ENV PKG_CONFIG_PATH=/opt/devkitpro/portlibs/wiiu/lib/pkgconfig:/opt/devkitpro/portlibs/ppc/lib/pkgconfig

WORKDIR /app
CMD ["python3", "scripts/build.py", "all"]

