.SUFFIXES:

# Allow building a package-specific RPX: set PACKAGED_GAME=1 or 2 when calling make
PACKAGED_GAME ?= 0

ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitPro")
endif


PKGCONFIG ?= $(DEVKITPRO)/portlibs/wiiu/bin/powerpc-eabi-pkg-config

include $(DEVKITPRO)/wut/share/wut_rules

CXXFLAGS_ALL = $(shell $(PKGCONFIG) --cflags --static vorbisfile vorbis 2>/dev/null) $(CXXFLAGS) \
               $(MACHDEP) -O2 -g -ffunction-sections -fdata-sections \
               -D__WIIU__ -D__WUT__ \
               -DPACKAGED_GAME=$(PACKAGED_GAME) \
               -I$(WUT_ROOT)/include \
               -DBASE_PATH='"$(BASE_PATH)"' \
               -DSTBI_NO_THREAD_LOCALS \
               -IRSDKv4/ \
               -IRSDKv4/NativeObjects/ \
               -Idependencies/all/asio/include/ \
               -Idependencies/all/stb-image/ \
               -Idependencies/all/tinyxml2/ \
               -DRETRO_WIIU_CF_AROMA \

LDFLAGS += -Wl,-T,RSDKv4/Platform/WiiUHeapAnchor.ld
LDFLAGS += $(ARCH) $(RPXSPECS)
# Ensure the WUT library directory is searched when linking so -lwut is found.
LDFLAGS += -L$(WUT_ROOT)/lib
LIBS = $(shell $(PKGCONFIG) --libs --static vorbisfile vorbis)

# Build SDL2 from local source (contains DRC render hook modifications)
SDL_DIR = dependencies/all/SDL
SDL_LIB = $(SDL_DIR)/libSDL2.a
CXXFLAGS_ALL += -I$(SDL_DIR)/include
CFLAGS_SDL = $(MACHDEP) -O2 -g -ffunction-sections -fdata-sections \
             -D__WIIU__ -D__WUT__ -I$(WUT_ROOT)/include \
             -I$(DEVKITPRO)/portlibs/ppc/include -I$(SDL_DIR)/include
LIBS := $(SDL_LIB) $(LIBS)

# Ensure WUT (Wii U system) libraries are linked after SDL/system libs
# so symbols like GX2*, OS* and WHB* are resolved. libwut provides aliases
# such as libgx2.a, libwhb.a, libproc_ui.a via symlinks in WUT_ROOT/lib.
LIBS += -lwut -lwhb -lproc_ui

# Fallback: ensure basic SDL libs are linked if pkg-config didn't find them
# If you need to force an SDL static link, add it to LIBS here (not enabled by default).

SOURCES = \
          dependencies/all/tinyxml2/tinyxml2.cpp \
          RSDKv4/Animation.cpp     \
          RSDKv4/Audio.cpp         \
          RSDKv4/Collision.cpp     \
          RSDKv4/Debug.cpp         \
          RSDKv4/Drawing.cpp       \
          RSDKv4/Ini.cpp           \
          RSDKv4/Input.cpp         \
          RSDKv4/main.cpp          \
          RSDKv4/Math.cpp          \
          RSDKv4/ModAPI.cpp        \
          RSDKv4/Networking.cpp	   \
          RSDKv4/Object.cpp        \
          RSDKv4/Palette.cpp       \
          RSDKv4/Reader.cpp        \
          RSDKv4/Renderer.cpp      \
          RSDKv4/RetroEngine.cpp   \
          RSDKv4/Scene.cpp         \
          RSDKv4/Scene3D.cpp       \
          RSDKv4/Script.cpp        \
          RSDKv4/Sprite.cpp        \
          RSDKv4/String.cpp        \
          RSDKv4/Text.cpp          \
          RSDKv4/Userdata.cpp      \
          RSDKv4/NativeObjects/AboutScreen.cpp \
          RSDKv4/NativeObjects/AchievementDisplay.cpp \
          RSDKv4/NativeObjects/AchievementsButton.cpp \
          RSDKv4/NativeObjects/AchievementsMenu.cpp \
          RSDKv4/NativeObjects/BackButton.cpp \
          RSDKv4/NativeObjects/CWSplash.cpp \
          RSDKv4/NativeObjects/CreditText.cpp \
          RSDKv4/NativeObjects/DialogPanel.cpp \
          RSDKv4/NativeObjects/FadeScreen.cpp \
          RSDKv4/NativeObjects/InstructionsScreen.cpp \
          RSDKv4/NativeObjects/LeaderboardsButton.cpp \
          RSDKv4/NativeObjects/MenuBG.cpp \
          RSDKv4/NativeObjects/MenuControl.cpp \
          RSDKv4/NativeObjects/ModInfoButton.cpp \
          RSDKv4/NativeObjects/ModsButton.cpp \
          RSDKv4/NativeObjects/ModsMenu.cpp \
          RSDKv4/NativeObjects/MultiplayerButton.cpp \
          RSDKv4/NativeObjects/MultiplayerScreen.cpp \
          RSDKv4/NativeObjects/OptionsButton.cpp \
          RSDKv4/NativeObjects/OptionsMenu.cpp \
          RSDKv4/NativeObjects/PauseMenu.cpp \
          RSDKv4/NativeObjects/PlayerSelectScreen.cpp \
          RSDKv4/NativeObjects/PushButton.cpp \
          RSDKv4/NativeObjects/RecordsScreen.cpp \
          RSDKv4/NativeObjects/RetroGameLoop.cpp \
          RSDKv4/NativeObjects/SaveSelect.cpp \
          RSDKv4/NativeObjects/SegaIDButton.cpp \
          RSDKv4/NativeObjects/SegaSplash.cpp \
          RSDKv4/NativeObjects/SettingsScreen.cpp \
          RSDKv4/NativeObjects/StaffCredits.cpp \
          RSDKv4/NativeObjects/StartGameButton.cpp \
          RSDKv4/NativeObjects/SubMenuButton.cpp \
          RSDKv4/NativeObjects/TextLabel.cpp \
          RSDKv4/NativeObjects/TimeAttack.cpp \
          RSDKv4/NativeObjects/TimeAttackButton.cpp \
          RSDKv4/NativeObjects/TitleScreen.cpp \
          RSDKv4/NativeObjects/VirtualDPad.cpp \
          RSDKv4/NativeObjects/VirtualDPadM.cpp \
          RSDKv4/NativeObjects/ZoneButton.cpp \
          RSDKv4/Platform/WiiUProc.cpp \
          RSDKv4/Platform/WiiUDRC.cpp \

ifneq ($(FORCE_CASE_INSENSITIVE),)
	CXXFLAGS_ALL += -DFORCE_CASE_INSENSITIVE
	SOURCES += RSDKv4/fcaseopen.c
endif

OFILES = $(SOURCES:%=objects/%.o)
LD = $(CXX)

# Collect SDL2 C sources via the same globs used by SDL's own Makefile.wiiu
SDL_CSOURCES = $(wildcard $(SDL_DIR)/src/*.c) \
               $(wildcard $(SDL_DIR)/src/atomic/*.c) \
               $(wildcard $(SDL_DIR)/src/audio/*.c) \
               $(wildcard $(SDL_DIR)/src/audio/wiiu/*.c) \
               $(wildcard $(SDL_DIR)/src/cpuinfo/*.c) \
               $(wildcard $(SDL_DIR)/src/events/*.c) \
               $(wildcard $(SDL_DIR)/src/file/*.c) \
               $(wildcard $(SDL_DIR)/src/haptic/*.c) \
               $(wildcard $(SDL_DIR)/src/haptic/dummy/*.c) \
               $(wildcard $(SDL_DIR)/src/joystick/*.c) \
               $(wildcard $(SDL_DIR)/src/joystick/wiiu/*.c) \
               $(wildcard $(SDL_DIR)/src/joystick/dummy/*.c) \
               $(wildcard $(SDL_DIR)/src/loadso/dummy/*.c) \
               $(wildcard $(SDL_DIR)/src/power/*.c) \
               $(wildcard $(SDL_DIR)/src/filesystem/dummy/*.c) \
               $(wildcard $(SDL_DIR)/src/render/*.c) \
               $(wildcard $(SDL_DIR)/src/render/wiiu/*.c) \
               $(wildcard $(SDL_DIR)/src/render/software/*.c) \
               $(wildcard $(SDL_DIR)/src/stdlib/*.c) \
               $(wildcard $(SDL_DIR)/src/sensor/*.c) \
               $(wildcard $(SDL_DIR)/src/thread/*.c) \
               $(wildcard $(SDL_DIR)/src/thread/wiiu/*.c) \
               $(wildcard $(SDL_DIR)/src/timer/*.c) \
               $(wildcard $(SDL_DIR)/src/timer/wiiu/*.c) \
               $(wildcard $(SDL_DIR)/src/timer/dummy/*.c) \
               $(wildcard $(SDL_DIR)/src/video/*.c) \
               $(wildcard $(SDL_DIR)/src/video/wiiu/*.c) \
               $(wildcard $(SDL_DIR)/src/video/yuv2rgb/*.c) \
               $(wildcard $(SDL_DIR)/src/video/dummy/*.c)
SDL_OFILES = $(SDL_CSOURCES:%.c=objects/%.o)

all: bin/RSDKv4.rpx
bin/RSDKv4.elf: $(OFILES) $(SDL_LIB) bin

$(SDL_LIB): $(SDL_OFILES)
	$(AR) rcs $@ $^

objects/$(SDL_DIR)/%.o: $(SDL_DIR)/%.c
	mkdir -p $(@D)
	$(CC) $(CFLAGS_SDL) -c $< -o $@

bin:
	mkdir -p bin

objects/%.o: %
	mkdir -p $(@D)
	$(CXX) $(CXXFLAGS_ALL) -std=c++17 $^ -o $@ -c

install: bin/RSDKv4
	install -Dp -m755 bin/RSDKv4 $(prefix)/bin/RSDKv4

clean:
	rm -r -f bin && rm -r -f objects && rm -f $(SDL_LIB)
